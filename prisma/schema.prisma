generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUBSCRIBER
  SYSTEM_ADMIN
  MEDICAL_SERVICE_PROVIDER
}

enum MedicalProviderType {
  HOSPITAL
  CLINIC
  LABORATORY
  PHARMACY
}

enum MedicalServiceCategory {
  LABORATORY
  PHARMACY
  EMERGENCY
  SURGERY
  DENTAL
}

enum ReimbursementRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  email    String   @unique
  password String
  role     UserRole
  phone    String?
  isActive Boolean  @default(true)

  medicalProviderProfile MedicalProviderProfile?
  insuranceSubscription  InsuranceSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalProviderProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid

  facilityName  String
  providerType  MedicalProviderType
  licenseNumber String              @unique
  address       String?
  city          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// table for insurance plans, including their details and pricing
model InsurancePlan {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  code                  String   @unique
  description           String?
  imageUrl              String?
  monthlyPrice          Decimal  @db.Decimal(10, 2)
  durationMonths        Int
  maximumAnnualCoverage Decimal? @db.Decimal(12, 2)
  isActive              Boolean  @default(true)

  coverages     PlanCoverage[]
  subscriptions InsuranceSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InsuranceSubscription {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriberId String  @unique @db.Uuid
  planId       String  @db.Uuid
  isActive     Boolean @default(false)

  subscriber User          @relation(fields: [subscriberId], references: [id])
  plan       InsurancePlan @relation(fields: [planId], references: [id])

  reimbursementRequests ReimbursementRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([isActive])
}

// table for medical services, including their details and categorization
model MedicalService {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String                 @unique
  description String?
  category    MedicalServiceCategory
  isActive    Boolean                @default(true)

  planCoverages PlanCoverage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// table for the many-to-many relationship between insurance plans and medical services, including coverage details for each service under a specific plan
model PlanCoverage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String @db.Uuid
  serviceId String @db.Uuid

  coveragePercentage Int
  annualLimit        Decimal? @db.Decimal(12, 2)
  notes              String?

  plan InsurancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  service MedicalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  reimbursementRequests ReimbursementRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, serviceId])
  @@index([planId])
  @@index([serviceId])
}

model ReimbursementRequest {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String @db.Uuid
  planCoverageId String @db.Uuid

  requestedAmount Decimal  @db.Decimal(12, 2)
  serviceDate     DateTime
  description     String?

  invoiceStorageKey   String @unique
  invoiceOriginalName String
  invoiceMimeType     String
  invoiceSize         Int

  status          ReimbursementRequestStatus @default(PENDING)
  rejectionReason String?

  subscription InsuranceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planCoverage PlanCoverage          @relation(fields: [planCoverageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([planCoverageId])
  @@index([status])
  @@index([createdAt])
}
